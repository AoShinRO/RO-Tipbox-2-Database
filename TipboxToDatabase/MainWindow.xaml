<Window x:Class="TipboxToDatabase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TipboxToDatabase"
        xmlns:properties="clr-namespace:TipboxToDatabase.Properties"
        mc:Ignorable="d"
       Title="Tipbox Generator" Height="320" Width="800">
    <Grid Margin="10">
        <Button Content="num2cardillustnametable.txt" FontFamily="Tahoma" FontWeight="Bold"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="112,9,0,0" Width="200" Height="40"
                Click="SelectNum2CardFile_Click" />
        <Button Content="iteminfo.lua/lub" FontFamily="Tahoma" FontWeight="Bold"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="392,9,0,0" Width="200" Height="40"
                Click="SelectItemInfoFile_Click" />
        <Button Content="Generate tipbox.lub and AdventureGuide Files" FontFamily="Tahoma" FontWeight="Bold" 
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="14,162,0,0" Width="746" Height="40"
                Click="GenerateTipbox_Click" />
        <Button Content="mob__db.yml" FontFamily="Tahoma" FontWeight="Bold"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="81,83,0,0" Width="100" Height="40"
            Click="SelectMobDBFile_Click" />
        <Button Content="item__db__etc.yml" FontFamily="Tahoma" FontWeight="Bold"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="266,83,0,0" Width="100" Height="40"
            Click="SelectItemETCFile_Click" />
        <TextBlock Name="Text" Text="Select your num2cardillustnametable.txt"
                   HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="10" TextAlignment="Center"
                   Margin="17,53,0,0" Width="380" Height="20"
                   TextWrapping="Wrap" />
        <TextBlock Name="Text2" Text="Select your iteminfo.lua/lub"
                   HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="10" TextAlignment="Center"
                   Margin="297,53,0,0" Width="380" Height="20"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="Text3" Text="Select your mob_db.yml"
            HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="10" TextAlignment="Center"
            Margin="60,128,0,0" Width="150" Height="40"
            TextWrapping="Wrap" />
        <TextBlock x:Name="Text4" Text="Select your item_db_etc.yml"
            HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="10" TextAlignment="Center"
            Margin="240,128,0,0" Width="150" Height="40"
            TextWrapping="Wrap" />
        <TextBlock x:Name="Text5" Text="Select your item_db_equip.yml"
            HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="10" TextAlignment="Center"
            Margin="424,128,0,0" Width="150" Height="40"
            TextWrapping="Wrap" />
        <TextBlock x:Name="Text6" Text="Select your item_db_usable.yml"
            HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="10" TextAlignment="Center"
            Margin="620,128,0,0" Width="150" Height="40"
            TextWrapping="Wrap" />
        <CheckBox x:Name="iiansi" Content="is ANSI?" HorizontalAlignment="Left" Margin="321,21,0,0" VerticalAlignment="Top" IsChecked="{Binding iiansi, Source={x:Static properties:Settings.Default}}" />
        <CheckBox x:Name="nun2ansi" Content="is ANSI?" HorizontalAlignment="Left" Margin="41,22,0,0" VerticalAlignment="Top" IsChecked="{Binding nun2ansi, Source={x:Static properties:Settings.Default}}" />
        <CheckBox x:Name="mobansi" Content="is ANSI?" HorizontalAlignment="Left" Margin="10,96,0,0" VerticalAlignment="Top" IsChecked="{Binding mobansi, Source={x:Static properties:Settings.Default}}" />
        <CheckBox x:Name="etcansi" Content="is ANSI?" HorizontalAlignment="Left" Margin="195,95,0,0" VerticalAlignment="Top" IsChecked="{Binding etcansi, Source={x:Static properties:Settings.Default}}" />
        <CheckBox x:Name="equipansi" Content="is ANSI?" HorizontalAlignment="Left" Margin="385,95,0,0" VerticalAlignment="Top" IsChecked="{Binding equipansi, Source={x:Static properties:Settings.Default}}" />
        <CheckBox x:Name="usableansi" Content="is ANSI?" HorizontalAlignment="Left" Margin="572,95,0,0" VerticalAlignment="Top" IsChecked="{Binding usableansi, Source={x:Static properties:Settings.Default}}" />
        <Button Content="item__db__equip.yml" FontFamily="Tahoma" FontWeight="Bold"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="456,83,0,0" Width="100" Height="40"
            Click="SelectItemEQUIPFile_Click" />
        <Button Content="item__db__usable.yml" FontFamily="Tahoma" FontWeight="Bold"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="643,83,0,0" Width="100" Height="40"
            Click="SelectItemUSABLEFile_Click" />
        <ProgressBar x:Name="ConversionProgressBar" Margin="14,210,20,42"
                     Minimum="0" Maximum="100"
                     Value="0" />
        <TextBlock Name="StatusText"
                   HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="15" TextAlignment="Center"
                   Margin="36,230,0,0" Width="680" Height="25"
                   TextWrapping="Wrap" />
        <CheckBox x:Name="tipansi" Content="ANSI output" HorizontalAlignment="Left" Margin="29,173,0,0" VerticalAlignment="Top" IsChecked="{Binding tipansi, Source={x:Static properties:Settings.Default}}" />
        <CheckBox x:Name="dropable_only" Content="dropable only" HorizontalAlignment="Left" Margin="131,173,0,0" VerticalAlignment="Top" IsChecked="{Binding dropable, Source={x:Static properties:Settings.Default}}" />
        <TextBlock x:Name="InputFolderPath" Text="Select your mob spawn folder"
            HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="10" TextAlignment="Center"
            Margin="620,56,0,0" Width="150" Height="40"
            TextWrapping="Wrap" />
        <Button Content="spawn folder" FontFamily="Tahoma" FontWeight="Bold"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="643,11,0,0" Width="100" Height="40"
            Click="SelectFolderButton_Click" />
    </Grid>
</Window>
